\section{The  format of Theorem, Lemma, Proof and etc.}
\subsection{Theorem and Lemma}
 \noindent{\bf 1. Input:}
\begin{verbatim}
\begin{theorem}\label{th1}
 Please state your theorem here.
 \end{theorem}
% `th1' is the label name of this theorem.
 \end{verbatim}

 \noindent{\bf Output:}
 \begin{theorem}\label{th1}
Please state your theorem here.
\end{theorem}

\medskip
\noindent{\bf 2. Input:}
\begin{verbatim}
\begin{lemma}[Lemma 2, \cite{H2013}]\label{le1}
 Please state your lemma here. The format of item is as follows:
\begin{enumerate}[(i)]
\item the first item;
\item the second item.
\end{enumerate}
\end{lemma}
 \end{verbatim}

 \noindent{\bf Output:}
 \begin{lemma}[Lemma 2, \cite{H2013}]
 \label{le1}
  Please state your lemma here. The format of item is as follows:
\begin{enumerate}[(i)]
\item the first item;
\item the second item.
\end{enumerate}
\end{lemma}

 \subsection{Proof}
\noindent{\bf Input:}

\begin{verbatim}
\begin{proof}
Please state your proof here.
\end{proof}
 \end{verbatim}

 \noindent{\bf Output:}

\begin{proof}
Please state your proof here.
\end{proof}


